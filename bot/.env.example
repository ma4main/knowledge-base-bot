# Образец конфигурации. Скопировать в bot/.env и заполнить.
# Сам .env в git не попадает (см. .gitignore): секретов в репозитории быть не должно.
# Описание всех переменных: docs/CONFIG.md.

# Токен от @BotFather
TELEGRAM_BOT_TOKEN=

# Ключ OpenRouter (https://openrouter.ai/keys)
OPENROUTER_API_KEY=

# Стартовая модель. Используется только при самом первом запуске, дальше выбор
# хранится в состоянии бота и меняется из меню. Рекомендации: docs/MODELS.md.
OPENROUTER_MODEL=google/gemini-3.7-flash

# Запасные модели через запятую, если основная недоступна. Пусто: значения по
# умолчанию из config.py; none: отключить совсем.
OPENROUTER_MODEL_FALLBACKS=

# Модель для классификатора типа запроса и сверки фразы для клиента.
# Задача простая, хватает самой дешёвой модели семейства.
CLASSIFIER_MODEL=google/gemini-3.5-flash-lite

# Сверять фразу для клиента с текстом единиц базы (1 да, 0 нет).
# Отдельный дешёвый вызов только на возражениях. Нашёл расхождение, дописывает
# предупреждение; сам ничего не переписывает.
CLIENT_PHRASE_AUDIT=1

# TTL кэша префикса у провайдера: 1h (запись ×2, выгодно при десятках вопросов
# в день) или 5m (запись ×1.25).
CACHE_TTL=1h

# Доступ. Списки через запятую.
#  - LEADER_IDS: числовые Telegram ID первых руководителей. Нужен только для
#    первого запуска: каждый ID импортируется в состояние бота один раз, дальше
#    руководителей назначают из меню («Люди и доступ»). Только числовой ID: ник
#    переназначаем, его можно перехватить. Свой ID человек видит по /whoami.
#    Аварийный вход, если все руководители недоступны: вписать НОВЫЙ ID и
#    перезапустить контейнер.
#  - MANAGER_IDS / MANAGER_USERNAMES: сотрудники, заданные на сервере. Лучше
#    оставить пустыми: из бота их не убрать, а добавить человека проще кнопкой.
LEADER_IDS=
MANAGER_IDS=
MANAGER_USERNAMES=

# Путь к клону базы знаний. В Docker подставляется автоматически.
# KB_ROOT=/app/kb

# Куда бот пишет своё: состояние, журналы, кэш, разговоры. В Docker это том
# kb-bot-data, подставляется автоматически.
# DATA_DIR=/data

# Предохранители агентского цикла: сколько раз подряд модель может звать
# инструменты и сколько секунд ждём её ответ.
# MAX_TOOL_ITERATIONS=6
# REQUEST_TIMEOUT=120

LOG_LEVEL=INFO
